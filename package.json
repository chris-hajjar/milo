{
  "name": "yahoo-finance-copilot-runtime",
  "version": "1.0.0",
  "type": "module",
  "description": "CopilotKit runtime that connects to Yahoo Finance MCP server",
  "main": "copilot-runtime.js",
  "scripts": {
    "runtime": "node copilot-runtime.js",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently --names \"RUNTIME,FRONTEND\" --prefix-colors \"blue,green\" \"npm run runtime\" \"npm run frontend\""
  },
  "dependencies": {
    "@copilotkit/runtime": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
